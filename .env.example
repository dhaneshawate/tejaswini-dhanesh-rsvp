# Free email delivery using a Gmail account + Google App Password.
# Enable 2-Step Verification on the Gmail account, then create an App Password.
SMTP_HOST=SMTP_EMAIL
SMTP_PORT=YOUR_SMTP_PORT
SMTP_SECURE=BOOLEAN
SMTP_USER=YOUR_SMTP_PASS
SMTP_PASS=YOUR_SMTP_PASS

# RSVP notifications are sent here.
RSVP_TO_EMAIL=abc@gmail.com